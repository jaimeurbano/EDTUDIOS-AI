# Copia este archivo como .env.local y rellena los valores de tu proyecto Supabase.
# Panel de Supabase → Project Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima

# IMPORTANTE:
# - La clave "anon" es pública y está protegida por las políticas RLS de supabase/schema.sql.
# - NUNCA pongas aquí la clave "service_role": esa clave omite RLS y no debe llegar al navegador.
